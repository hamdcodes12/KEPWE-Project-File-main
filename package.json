{
  "name": "kepwe-marketing-site",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "install:backend": "npm ci --prefix backend --omit=dev --registry=https://registry.npmjs.org",
    "render-build": "node scripts/prepare-render-lockfile.mjs && npm ci --include=dev --registry=https://registry.npmjs.org && npm run build && npm run install:backend",
    "start": "npm run start --prefix backend",
    "migrate": "npm run migrate --prefix backend"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.2",
    "express-rate-limit": "^7.5.1",
    "gsap": "^3.15.0",
    "helmet": "^7.2.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.35.0",
    "pg": "^8.23.0",
    "razorpay": "^2.9.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "vite": "^5.4.21"
  }
}
