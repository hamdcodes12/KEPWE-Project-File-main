# Copy this file to `.env` in the project root and fill in real values.
# This file is committed to version control; `.env` is NOT (see .gitignore).

# ── Database ─────────────────────────────────────────────────────────────
# PostgreSQL connection string used by the backend (backend/src/config/db.js)
DATABASE_URL=postgresql://user:password@host:5432/kepwe

# ── Auth / JWT ───────────────────────────────────────────────────────────
# Required in production. Generate a long random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=15m

# ── CORS ─────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for the backend API.
# NOT needed when the frontend is served by this same backend (the default
# single-service Render deployment) — same-origin requests are always
# allowed regardless of this value. Only set this if you split the frontend
# out to its own separate domain/static site, e.g.:
#   CORS_ORIGINS=https://kepwe.com,https://www.kepwe.com
CORS_ORIGINS=

# ── Server ───────────────────────────────────────────────────────────────
# On Render, PORT is injected automatically — do NOT hardcode it there.
PORT=3001
NODE_ENV=development

# ── Frontend (Vite) ────────────────────────────────────────────────────────
# Leave as "/api" for the single-service deployment (frontend + backend on
# the same Render service/origin). Only override this if the frontend is
# deployed separately from the backend, e.g.:
#   VITE_API_BASE_URL=https://kepwe-backend.onrender.com/api
VITE_API_BASE_URL=/api
VITE_APP_NAME="KEPWE - Everything Your Business Needs"
VITE_APP_ENV=production

# ── OANOR market-data API (optional; only needed for IndexPilot live market data) ──
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_ACCESS_TOKEN=
UPSTOX_REDIRECT_URI=
UPSTOX_TIMEOUT_MS=8000
UPSTOX_CACHE_TTL_MS=60000

# Required before enabling any live broker OAuth token storage. Generate a
# random 32-byte hexadecimal value and store it in managed secrets.
BROKER_TOKEN_ENCRYPTION_KEY=

# One-time production bootstrap. Set RESET_PASSWORD=true only for the
# deployment that must establish/reset the requested admin credentials.
ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_BOOTSTRAP_RESET_PASSWORD=false

# ── Razorpay Payment Gateway ──────────────────────────────────────────────────
# Get these from https://dashboard.razorpay.com → Settings → API Keys.
# Use rzp_test_* keys for test mode, rzp_live_* for production.
# RAZORPAY_KEY_SECRET is BACKEND-ONLY — never set it as a VITE_ variable.
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXX
RAZORPAY_KEY_SECRET=XXXXXXXXXXXXXXXXXXXXXXXX
# VITE_RAZORPAY_KEY_ID is the public key ID used by the frontend checkout script.
# It is the same value as RAZORPAY_KEY_ID but exposed to Vite so the browser
# can load the Razorpay checkout. The secret is NEVER included here.
VITE_RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXX
