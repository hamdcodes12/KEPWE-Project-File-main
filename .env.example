# Copy this file to `.env` in the project root and fill in real values.
# This file is committed to version control; `.env` is NOT (see .gitignore).

# ── Database ─────────────────────────────────────────────────────────────
# PostgreSQL connection string used by the backend (backend/src/config/db.js)
DATABASE_URL=postgresql://user:password@host:5432/kepwe

# ── Auth / JWT ───────────────────────────────────────────────────────────
# Required in production. Generate a long random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=15m

# ── Email OTP authentication ───────────────────────────────────────────
# Backend-only Resend credentials. Never prefix these with VITE_ and never
# expose them to the browser.
RESEND_API_KEY=
# Use the verified mail.kepwe.in sender once Resend domain verification is complete.
OTP_FROM_EMAIL="KEPWE <help@kepwe.in>"

# ── CORS ─────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for the backend API.
# NOT needed when the frontend is served by this same backend (the default
# single-service Render deployment) — same-origin requests are always
# allowed regardless of this value. Only set this if you split the frontend
# out to its own separate domain/static site, e.g.:
#   CORS_ORIGINS=https://kepwe.com,https://www.kepwe.com
CORS_ORIGINS=

# ── Server ───────────────────────────────────────────────────────────────
# On Render, PORT is injected automatically — do NOT hardcode it there.
PORT=3001
NODE_ENV=development

# ── Frontend (Vite) ────────────────────────────────────────────────────────
# Leave as "/api" for the single-service deployment (frontend + backend on
# the same Render service/origin). Only override this if the frontend is
# deployed separately from the backend, e.g.:
#   VITE_API_BASE_URL=https://kepwe-backend.onrender.com/api
VITE_API_BASE_URL=/api
VITE_APP_NAME="KEPWE - Everything Your Business Needs"
VITE_APP_ENV=production

# ── OANOR market-data API (optional; only needed for IndexPilot live market data) ──
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_ACCESS_TOKEN=
UPSTOX_REDIRECT_URI=
UPSTOX_TIMEOUT_MS=8000
UPSTOX_CACHE_TTL_MS=60000

# ── LemonN production API trading ────────────────────────────────────────────
# The API key, Ed25519 private secret (32-byte hex), and client ID remain
# backend-only. The daily access token is generated after the browser login and
# stored encrypted in broker_oauth_tokens; do not place it in frontend config.
LEMONN_API_KEY=
LEMONN_API_SECRET=
LEMONN_CLIENT_ID=
LEMONN_REDIRECT_URL=https://kepwe.in/api/broker/lemonn/callback

# Required before enabling any live broker OAuth token storage. Generate a
# random 32-byte hexadecimal value and store it in managed secrets.
BROKER_TOKEN_ENCRYPTION_KEY=

# One-time production bootstrap. Set RESET_PASSWORD=true only for the
# deployment that must establish/reset the requested admin credentials.
ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_BOOTSTRAP_RESET_PASSWORD=false

# ── Razorpay Payment Gateway ──────────────────────────────────────────────────
# Get these from https://dashboard.razorpay.com → Settings → API Keys.
# Use rzp_test_* keys for test mode, rzp_live_* for production.
# RAZORPAY_KEY_SECRET is BACKEND-ONLY — never set it as a VITE_ variable.
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXX
RAZORPAY_KEY_SECRET=XXXXXXXXXXXXXXXXXXXXXXXX
# VITE_RAZORPAY_KEY_ID is the public key ID used by the frontend checkout script.
# It is the same value as RAZORPAY_KEY_ID but exposed to Vite so the browser
# can load the Razorpay checkout. The secret is NEVER included here.
VITE_RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXX

# ── KEPWE Ledger Government & Provider Integrations ───────────────────────────
# See INTEGRATION_SETUP.md for complete configuration instructions.
# All accounting, GST, and TDS features work without these credentials.
# Supply these only when you want to connect authorized government APIs.

# E-Invoice (NIC / GSP API v1.03)
EINVOICE_ENV=sandbox
EINVOICE_BASE_URL=https://einv-apisandbox.nic.in/eivp/v1.03
EINVOICE_CLIENT_ID=
EINVOICE_CLIENT_SECRET=
EINVOICE_USERNAME=
EINVOICE_PASSWORD=
EINVOICE_TIMEOUT_MS=10000

# E-Way Bill (NIC E-Way Bill API v1.03)
EWAYBILL_ENV=sandbox
EWAYBILL_BASE_URL=https://ewb.nic.in/api/sandbox
EWAYBILL_CLIENT_ID=
EWAYBILL_CLIENT_SECRET=
EWAYBILL_USERNAME=
EWAYBILL_PASSWORD=

# GST Portal / GSP API (GSTR-1 / GSTR-3B filing)
GST_ENV=sandbox
GST_BASE_URL=https://api.gsp.nic.in/taxpayerapi/v0.3
GST_CLIENT_ID=
GST_CLIENT_SECRET=
GST_USERNAME=
GST_PASSWORD=
GSTIN=27AAAAA0000A1Z5
GST_STATE_CODE=27

# TDS / TRACES Portal (NSDL Form 26Q & ITNS 281 Challan Verification)
TDS_ENV=sandbox
TDS_BASE_URL=https://traces.gov.in/api/v1
TDS_CLIENT_ID=
TDS_CLIENT_SECRET=
TRACES_TAN=MUMB12345C
TRACES_USER_ID=
TRACES_PASSWORD=

# ReBIT Account Aggregator (Open Banking statement sync)
AA_ENV=sandbox
AA_BASE_URL=https://api.accountaggregator.in/v1
AA_CLIENT_ID=
AA_CLIENT_SECRET=
AA_FIU_ID=FIU-KEPWE-LEDGER
AA_KEY_MATERIAL=

# EPFO & ESIC Compliance (Monthly ECR & Challan gateway)
PAYROLL_ENV=sandbox
PAYROLL_BASE_URL=https://unifiedportal-emp.epfindia.gov.in/epfo/api/v1
EPFO_ESTABLISHMENT_ID=
EPFO_USER_ID=
EPFO_PASSWORD=
ESIC_EMPLOYER_CODE=

# Income Tax ERI (Electronic Return Intermediary - Keep disabled until authorized)
ERI_ENABLED=false
ERI_ENV=sandbox
ERI_BASE_URL=https://e-filing.incometax.gov.in/e-Filing/services/v1
ERI_USER_ID=
ERI_PASSWORD=
ERI_CLIENT_ID=
ERI_CLIENT_SECRET=
ERI_CERT_PATH=
ERI_CERT_PASSWORD=


