# Copy this file to `.env` in the project root and fill in real values.
# This file is committed to version control; `.env` is NOT (see .gitignore).

# ── Database ─────────────────────────────────────────────────────────────
# Supabase PostgreSQL connection string used by the backend.
SUPABASE_DB_URL=postgresql://user:password@host:5432/postgres

# ── Auth / JWT ───────────────────────────────────────────────────────────
# Required in production. Generate a long random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=15m

# ── Email OTP authentication ───────────────────────────────────────────
# Backend-only Resend credentials. Never prefix these with VITE_ and never
# expose them to the browser.
RESEND_API_KEY=
# Use the verified mail.kepwe.in sender once Resend domain verification is complete.
OTP_FROM_EMAIL="KEPWE <help@kepwe.in>"

# ── CORS ─────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for the backend API.
# NOT needed when the frontend is served by this same backend (the default
# single-service Render deployment) — same-origin requests are always
# allowed regardless of this value. Only set this if you split the frontend
# out to its own separate domain/static site, e.g.:
#   CORS_ORIGINS=https://kepwe.com,https://www.kepwe.com
CORS_ORIGINS=

# ── Server ───────────────────────────────────────────────────────────────
# On Render, PORT is injected automatically — do NOT hardcode it there.
PORT=3001
NODE_ENV=development

# ── Frontend (Vite) ────────────────────────────────────────────────────────
# Leave as "/api" for the single-service deployment (frontend + backend on
# the same Render service/origin). Only override this if the frontend is
# deployed separately from the backend, e.g.:
#   VITE_API_BASE_URL=https://kepwe-backend.onrender.com/api
VITE_API_BASE_URL=/api
VITE_APP_NAME="KEPWE - Everything Your Business Needs"
VITE_APP_ENV=production

# ── OANOR market-data API (optional; only needed for IndexPilot live market data) ──
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_ACCESS_TOKEN=
UPSTOX_REDIRECT_URI=
UPSTOX_TIMEOUT_MS=8000
UPSTOX_CACHE_TTL_MS=60000

# ── Angel One SmartAPI (the only supported broker for KEPWE Quant) ──────────
# Each user connects their own Angel One account with client code + MPIN + TOTP.
# The MPIN/TOTP are used once for the SmartAPI login and are never stored; the
# session tokens are stored encrypted in broker_oauth_tokens.
#
# Optional shared SmartAPI key (smartapi.angelone.in > My Profile > My APIs).
# Leave empty to make every user supply the API key of their own SmartAPI app.
ANGEL_ONE_API_KEY=
# Static IP this server uses for outbound traffic. It must be registered for
# the SmartAPI key in the SmartAPI portal; Angel One executes order APIs only
# from registered static IPs. Live orders stay blocked until this is set AND
# equals the server's detected outbound IP.
ANGEL_ONE_STATIC_IP=
# Current NSE quantity-freeze limit for NIFTY index options (per NSE circular).
# Order sizing is blocked until this is set.
ANGEL_ONE_NIFTY_FREEZE_QTY=
# Redirect URL registered in the SmartAPI app (only for "Login on Angel One").
ANGEL_ONE_REDIRECT_URL=https://kepwe.in/api/angel-one/callback
# Shared secret for the order postback URL registered in the SmartAPI app:
#   https://kepwe.in/api/angel-one/postback?token=<ANGEL_ONE_WEBHOOK_TOKEN>
ANGEL_ONE_WEBHOOK_TOKEN=
# Optional operator account: when all three are set, the account with this
# client code is logged in again automatically after Angel One's daily session
# expiry. Other users reconnect once per trading day.
ANGEL_ONE_CLIENT_CODE=
ANGEL_ONE_MPIN=
ANGEL_ONE_TOTP_SECRET=
# Optional request metadata headers sent to SmartAPI.
ANGEL_ONE_CLIENT_LOCAL_IP=
ANGEL_ONE_CLIENT_PUBLIC_IP=
ANGEL_ONE_MAC_ADDRESS=
# Optional overrides (defaults shown).
# ANGEL_ONE_BASE_URL=https://apiconnect.angelone.in
# ANGEL_ONE_SCRIP_MASTER_URL=https://margincalculator.angelone.in/OpenAPI_File/files/OpenAPIScripMaster.json
# ANGEL_ONE_TIMEOUT_MS=10000

# Required before any Angel One session can be stored. Generate a
# random 32-byte hexadecimal value and store it in managed secrets.
BROKER_TOKEN_ENCRYPTION_KEY=

# One-time production bootstrap. Set RESET_PASSWORD=true only for the
# deployment that must establish/reset the requested admin credentials.
ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_BOOTSTRAP_RESET_PASSWORD=false

# ── Razorpay Payment Gateway ──────────────────────────────────────────────────
# Get these from https://dashboard.razorpay.com → Settings → API Keys.
# Use rzp_test_* keys for test mode, rzp_live_* for production.
# RAZORPAY_KEY_SECRET is BACKEND-ONLY — never set it as a VITE_ variable.
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXX
RAZORPAY_KEY_SECRET=XXXXXXXXXXXXXXXXXXXXXXXX
# VITE_RAZORPAY_KEY_ID is the public key ID used by the frontend checkout script.
# It is the same value as RAZORPAY_KEY_ID but exposed to Vite so the browser
# can load the Razorpay checkout. The secret is NEVER included here.
VITE_RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXX
